# Copy to .env and edit. Everything here has a working default except the Apple
# revocation keys, which you only need before you ship.

PORT=8080

# Must match PRODUCT_BUNDLE_IDENTIFIER in Xcode — it is the `aud` claim Apple puts
# in the identity token, and sign-in fails with a clear error if it disagrees.
APPLE_BUNDLE_ID=doody.lego

# Turn on the moderation queue at /v1/admin/queue. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Account deletion must also revoke the Apple connection (Guideline 5.1.1(v)).
# From developer.apple.com → Certificates, Identifiers & Profiles → Keys:
# create a key with "Sign in with Apple" enabled and download the .p8 once.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Set to production to disable /v1/auth/dev. Do this before you deploy anywhere.
NODE_ENV=development
